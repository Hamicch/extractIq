# ExtractIQ Production Environment Variables
# Copy this to .env and fill in your values

# ===================================
# DATABASE
# ===================================
DB_PASSWORD=your-secure-database-password-here

# ===================================
# REDIS
# ===================================
REDIS_PASSWORD=your-secure-redis-password-here

# ===================================
# AI PROVIDER
# ===================================
# Provider: openai | anthropic | ollama | groq
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# OpenAI API Key (required if using OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (required if using Anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ===================================
# AUTHENTICATION
# ===================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here-generate-with-openssl-rand
API_KEY_SECRET=your-api-key-secret-here-generate-with-openssl-rand

# ===================================
# APP CONFIGURATION
# ===================================
# Your domain (e.g., https://extractiq.xyz)
APP_URL=https://extractiq.xyz
DOMAIN=extractiq.xyz
CORS_ORIGIN=https://extractiq.xyz

# Admin email for SSL certificates
ADMIN_EMAIL=admin@extractiq.xyz

# ===================================
# WORKER CONFIGURATION
# ===================================
WORKER_CONCURRENCY=5
WORKER_RATE_LIMIT_MAX=10
WORKER_RATE_LIMIT_DURATION=1000

# ===================================
# UPLOAD CONFIGURATION
# ===================================
# Max file size in bytes (50MB default)
MAX_FILE_SIZE=52428800
