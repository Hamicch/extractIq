# ========================================
# ExtractIQ Environment Configuration
# ========================================
# Copy this file to .env and fill in your values

# ========================================
# Database Configuration
# ========================================
DATABASE_URL=postgresql://extractiq:extractiq_dev@localhost:5433/extractiq

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# AI Provider Configuration
# ========================================
# Supported providers: openai, anthropic, ollama
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# OpenAI API Key (required if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (required if using anthropic provider)
ANTHROPIC_API_KEY=

# Ollama Configuration (required if using ollama provider)
OLLAMA_BASE_URL=http://localhost:11434

# ========================================
# Authentication & Security
# ========================================
# Generate secure random strings (minimum 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_chars_change_this_in_production
API_KEY_SECRET=your_api_key_secret_min_32_chars_change_this_in_production

# ========================================
# Application Configuration
# ========================================
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# ========================================
# Background Worker Configuration
# ========================================
WORKER_CONCURRENCY=5
WORKER_RATE_LIMIT_MAX=10
WORKER_RATE_LIMIT_DURATION=1000

# ========================================
# Upload Configuration
# ========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# ========================================
# Observability (Optional)
# ========================================
# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=extractiq

# ========================================
# Storage Configuration (Optional)
# ========================================
# Local storage (default)
STORAGE_TYPE=local

# AWS S3 Configuration (if using S3 storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=extractiq-documents

# ========================================
# Feature Flags (Optional)
# ========================================
ENABLE_TELEMETRY=true
ENABLE_METRICS=true
ENABLE_TRACING=true

# ========================================
# Development Only
# ========================================
# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Enable debug logging
# DEBUG=extractiq:*
