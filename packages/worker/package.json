{
  "name": "@docuflow/worker",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test:job": "tsx src/test-job.ts",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --ci",
    "eval": "tsx src/eval/run-eval.ts",
    "eval:watch": "tsx watch src/eval/run-eval.ts"
  },
  "dependencies": {
    "@docuflow/db": "*",
    "@docuflow/shared": "*",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.47.0",
    "@opentelemetry/sdk-node": "^0.47.0",
    "@types/pdf-parse": "^1.1.5",
    "bullmq": "^5.1.9",
    "dotenv": "^16.4.1",
    "ioredis": "^5.3.2",
    "openai": "^4.77.0",
    "pdf-parse": "^2.2.0",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
