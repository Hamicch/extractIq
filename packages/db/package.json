{
  "name": "@extractiq/db",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "DATABASE_URL=postgresql://extractiq:extractiq_dev@localhost:5433/extractiq tsx src/seed.ts",
    "db:migrate": "drizzle-kit migrate",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "@extractiq/shared": "*",
    "dotenv": "^16.4.1",
    "drizzle-orm": "^0.33.0",
    "pg": "^8.11.3",
    "postgres": "^3.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "drizzle-kit": "^0.24.2",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
